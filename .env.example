# AI provider selection: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# Gemini provider (AI_PROVIDER=gemini)
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI-compatible provider (AI_PROVIDER=openai)
# OPENAI_BASE_URL works with any chat-completions endpoint
# (OpenAI, Azure, OpenRouter, Ollama, LM Studio, vLLM, …)
#OPENAI_API_KEY=your-api-key-here
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

RATE_LIMIT_RPM=10
